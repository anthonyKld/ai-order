APP_NAME="AI Order"
APP_ENV=local
# Opcional. Vazio detecta o subdiretório local automaticamente.
# XAMPP: http://localhost/ai-order/public
# Servidor PHP: http://127.0.0.1:8000
APP_URL=
APP_TIMEZONE=America/Manaus

# A conexão é aberta apenas quando solicitada. Dashboard não depende do MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_order
DB_USERNAME=
DB_PASSWORD=

# Exclusivamente no servidor. Escolha um modelo com Responses API e Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# TODO(Gemini): documentar aqui as variáveis do novo provedor quando o adaptador existir.
# Uma chave Gemini não funciona em OPENAI_API_KEY. Plano de testes: docs/TESTES-GEMINI.md.
