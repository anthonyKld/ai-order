APP_NAME="AI Order"
APP_ENV=local
# Opcional. Vazio detecta o subdiretório local automaticamente.
# XAMPP: http://localhost/ai-order/public
# Servidor PHP: http://127.0.0.1:8000
APP_URL=
APP_TIMEZONE=America/Manaus

# A conexão é aberta apenas quando solicitada. Dashboard não depende do MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_order
DB_USERNAME=
DB_PASSWORD=

# Exclusivamente no servidor. Modelo Gemini com suporte a saída JSON estruturada.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
